# Environment variables declared in this file are loaded by prisma.config.ts (dotenv/config)
# and by Next.js automatically.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/xprim_dev?schema=public"

# --- Auth (NextAuth / Auth.js) ----------------------------------------------
# Generate a real secret for any non-local environment: `openssl rand -base64 32`
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Required when self-hosting (not on Vercel) so Auth.js trusts the incoming Host header.
AUTH_TRUST_HOST="true"

# --- SurveyMonkey (optional, for the SurveyMonkey provider integration) -----
# Not required for V1 (manual/external survey links work without these).
SURVEYMONKEY_CLIENT_ID=""
SURVEYMONKEY_CLIENT_SECRET=""
SURVEYMONKEY_ACCESS_TOKEN=""

# --- Future payment / payout providers --------------------------------------
# Reserved for Phase 2+ reward automation. Not used in V1.
PAYMENT_PROVIDER_API_KEY=""
